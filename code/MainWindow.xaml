<!-- code/MainWindow.xaml -->
<Window x:Class="Leron.Audio.MainWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:controls="clr-namespace:Leron.Audio.Controls"
Title="LERON-AUDIO"
Width="1180" Height="720"
MinWidth="980" MinHeight="600"
WindowStartupLocation="CenterScreen"
WindowStyle="None"
Background="{StaticResource BrushBg}"
Style="{StaticResource BaseWindow}">
<WindowChrome.WindowChrome>
<WindowChrome CaptionHeight="0"
ResizeBorderThickness="6"
GlassFrameThickness="0"
CornerRadius="0"
UseAeroCaptionButtons="False"/>
</WindowChrome.WindowChrome>
<Window.Resources>
<BooleanToVisibilityConverter x:Key="BoolVis"/>
</Window.Resources>
<Grid>
<Grid.RowDefinitions>
<RowDefinition Height="Auto"/>
<RowDefinition Height="*"/>
<RowDefinition Height="Auto"/>
</Grid.RowDefinitions>
<!-- Тайтл-бар -->
<Border Grid.Row="0" Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1"
MouseLeftButtonDown="OnTitleBarMouseDown">
<Grid Height="46">
<StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
<Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource BrushAccentGradient}" Margin="0,0,10,0">
<Viewbox Width="14" Height="14">
<Path Fill="White" Data="M4,10 L4,14 M8,6 L8,18 M12,3 L12,21 M16,7 L16,17 M20,10 L20,14" Stroke="White" StrokeThickness="2.4"/>
</Viewbox>
</Border>
<TextBlock Text="LERON-AUDIO" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
<Border Style="{StaticResource Chip}" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
<TextBlock Style="{StaticResource ChipMutedText}" Text="v0.1"/>
</Border>
</StackPanel>
<Border Style="{StaticResource Chip}" Padding="14,6" HorizontalAlignment="Center" VerticalAlignment="Center">
<StackPanel Orientation="Horizontal">
<Ellipse Width="8" Height="8" Fill="{StaticResource BrushOk}" VerticalAlignment="Center" Margin="0,0,8,0"/>
<TextBlock Text="{Binding StatusPillText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
</StackPanel>
</Border>
<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0" VerticalAlignment="Center">
<Button Style="{StaticResource CaptionButton}" Click="OnMinimizeClick" ToolTip="Свернуть">
<Path Width="10" Height="1" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Data="M0,0.5 L10,0.5"/>
</Button>
<Button Style="{StaticResource CaptionButton}" Click="OnMaximizeClick" ToolTip="Развернуть" Margin="4,0">
<Path Width="10" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Data="M0.5,0.5 L9.5,0.5 L9.5,9.5 L0.5,9.5 Z"/>
</Button>
<Button Style="{StaticResource CaptionCloseButton}" Click="OnCloseClick" ToolTip="Закрыть">
<Path Width="10" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Data="M0,0 L10,10 M10,0 L0,10"/>
</Button>
</StackPanel>
</Grid>
</Border>
<!-- Контент -->
<Grid Grid.Row="1">
<Grid.ColumnDefinitions>
<ColumnDefinition Width="230"/>
<ColumnDefinition Width="*"/>
<ColumnDefinition Width="340"/>
</Grid.ColumnDefinitions>
<!-- Сайдбар -->
<Border Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,1,0">
<StackPanel Margin="12">
<RadioButton x:Name="NavRecord" Style="{StaticResource NavButton}" GroupName="Nav" IsChecked="True" Checked="NavRecord_Checked" Margin="0,0,0,4">
<StackPanel Orientation="Horizontal">
<Viewbox Width="16" Height="16" Margin="0,0,10,0">
<Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Data="F1 M12,2A3,3 0 0,1 15,5V11A3,3 0 0,1 12,14A3,3 0 0,1 9,11V5A3,3 0 0,1 12,2M19,11C19,14.53 16.39,17.44 13,17.93V21H11V17.93C7.61,17.44 5,14.53 5,11H7A5,5 0 0,0 12,16A5,5 0 0,0 17,11H19Z"/>
</Viewbox>
<TextBlock Text="Запись" VerticalAlignment="Center"/>
</StackPanel>
</RadioButton>
<RadioButton x:Name="NavHistory" Style="{StaticResource NavButton}" GroupName="Nav" Checked="NavHistory_Checked" Margin="0,0,0,4">
<StackPanel Orientation="Horizontal">
<Viewbox Width="16" Height="16" Margin="0,0,10,0">
<Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Data="F1 M12,2 C6.5,2 2,6.5 2,12 C2,17.5 6.5,22 12,22 C17.5,22 22,17.5 22,12 C22,6.5 17.5,2 12,2 Z M12,20 C7.6,20 4,16.4 4,12 C4,7.6 7.6,4 12,4 C16.4,4 20,7.6 20,12 C20,16.4 16.4,20 12,20 Z M12.5,7 L11,7 L11,13 L16.2,16.2 L17,14.9 L12.5,12.2 L12.5,7 Z"/>
</Viewbox>
<TextBlock Text="История" VerticalAlignment="Center"/>
</StackPanel>
</RadioButton>
<RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" GroupName="Nav" Checked="NavSettings_Checked" Margin="0,0,0,12">
<StackPanel Orientation="Horizontal">
<Viewbox Width="16" Height="16" Margin="0,0,10,0">
<Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Data="M19.4,13 C19.4,12.7 19.5,12.3 19.5,12 C19.5,11.7 19.4,11.3 19.4,11 L21.5,9.4 C21.7,9.2 21.7,9 21.6,8.8 L19.6,5.4 C19.5,5.2 19.2,5.1 19,5.2 L16.5,6.2 C16,5.8 15.4,5.4 14.8,5.2 L14.4,2.6 C14.4,2.4 14.2,2.2 14,2.2 L10,2.2 C9.8,2.2 9.6,2.4 9.6,2.6 L9.2,5.2 C8.6,5.4 8,5.8 7.5,6.2 L5,5.2 C4.8,5.1 4.5,5.2 4.4,5.4 L2.4,8.8 C2.3,9 2.3,9.2 2.5,9.4 L4.6,11 C4.6,11.3 4.5,11.7 4.5,12 C4.5,12.3 4.6,12.7 4.6,13 L2.5,14.6 C2.3,14.8 2.3,15 2.4,15.2 L4.4,18.6 C4.5,18.8 4.8,18.9 5,18.8 L7.5,17.8 C8,18.2 8.6,18.6 9.2,18.8 L9.6,21.4 C9.6,21.6 9.8,21.8 10,21.8 L14,21.8 C14.2,21.8 14.4,21.6 14.4,21.4 L14.8,18.8 C15.4,18.6 16,18.2 16.5,17.8 L19,18.8 C19.2,18.9 19.5,18.8 19.6,18.6 L21.6,15.2 C21.7,15 21.7,14.8 21.5,14.6 L19.4,13 Z M12,15.5 C10.1,15.5 8.5,13.9 8.5,12 C8.5,10.1 10.1,8.5 12,8.5 C13.9,8.5 15.5,10.1 15.5,12 C15.5,13.9 13.9,15.5 12,15.5 Z"/>
</Viewbox>
<TextBlock Text="Настройки" VerticalAlignment="Center"/>
</StackPanel>
</RadioButton>
<Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
<StackPanel>
<TextBlock Style="{StaticResource SectionHeader}" Text="УСТРОЙСТВО"/>
<TextBlock Text="{Binding MicrophoneName}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,8"/>
<controls:LevelMeter x:Name="LevelMeterSide" Height="14" Segmented="True"/>
</StackPanel>
</Border>
<Border Style="{StaticResource CardBorder}">
<StackPanel HorizontalAlignment="Center">
<Border Background="{StaticResource BrushAccentDim}" BorderBrush="{StaticResource BrushAccent}" BorderThickness="1" CornerRadius="8" Padding="14,8" HorizontalAlignment="Center">
<TextBlock Text="{Binding HotkeyLabel}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushAccent}"/>
</Border>
<TextBlock Style="{StaticResource ChipMutedText}" Text="Хоткей push-to-talk" Margin="0,8,0,0"/>
</StackPanel>
</Border>
</StackPanel>
</Border>
<!-- Центр: страница Запись -->
<Grid Grid.Column="1" Visibility="{Binding ShowRecord, Converter={StaticResource BoolVis}}">
<Grid.RowDefinitions>
<RowDefinition Height="Auto"/>
<RowDefinition Height="*"/>
<RowDefinition Height="Auto"/>
</Grid.RowDefinitions>
<Border Style="{StaticResource CardBorder}" Margin="20,20,20,0">
<StackPanel>
<Grid Margin="0,0,0,10">
<TextBlock Style="{StaticResource ChipText}" Text="ЖИВАЯ ВОЛНА" FontSize="13" HorizontalAlignment="Left"/>
<TextBlock Text="{Binding RecordTimerText}" FontFamily="Consolas" FontSize="16" HorizontalAlignment="Right"/>
</Grid>
<controls:LevelMeter x:Name="WaveBars" Height="110" VerticalBars="True"/>
</StackPanel>
</Border>
<StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="20,16">
<Button x:Name="PttButton"
Command="{Binding ToggleRecordingCommand}"
RenderTransformOrigin="0.5,0.5"
Width="176" Height="176"
HorizontalAlignment="Center"
Margin="0,0,0,14">
<Button.Style>
<Style TargetType="Button" BasedOn="{StaticResource PttRoundButton}">
<Style.Triggers>
<DataTrigger Binding="{Binding IsRecording}" Value="True">
<Setter Property="Background" Value="White"/>
<Setter Property="Foreground" Value="#0B0F10"/>
</DataTrigger>
</Style.Triggers>
</Style>
</Button.Style>
<!-- МИКРОФОН ПО ЦЕНТРУ: квадратный icon-box 24x24 внутри Viewbox даёт
симметричный uniform-масштаб; Canvas.Top=0.5 компенсирует смещение
геометрии (центр масс 11.5 -> 12). Высота глифа прежняя: 71*19/24 ≈ 56. -->
<Viewbox Width="71" Height="71" Stretch="Uniform"
HorizontalAlignment="Center" VerticalAlignment="Center">
<Canvas Width="24" Height="24">
<Path Canvas.Top="0.5"
Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
Data="F1 M12,2A3,3 0 0,1 15,5V11A3,3 0 0,1 12,14A3,3 0 0,1 9,11V5A3,3 0 0,1 12,2M19,11C19,14.53 16.39,17.44 13,17.93V21H11V17.93C7.61,17.44 5,14.53 5,11H7A5,5 0 0,0 12,16A5,5 0 0,0 17,11H19Z"/>
</Canvas>
</Viewbox>
</Button>
<TextBlock Text="{Binding RecordHint}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
</StackPanel>
<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="20,0,20,20">
<Border Style="{StaticResource Chip}" Margin="0,0,8,0">
<TextBlock Foreground="{StaticResource BrushMuted}" FontSize="12">
<Run Text="Сессий сегодня: "/><Run Foreground="{StaticResource BrushAccent}" FontWeight="SemiBold" Text="{Binding SessionsToday, Mode=OneWay}"/>
</TextBlock>
</Border>
<Border Style="{StaticResource Chip}" Margin="0,0,8,0">
<TextBlock Foreground="{StaticResource BrushMuted}" FontSize="12">
<Run Text="Слов сегодня: "/><Run Foreground="{StaticResource BrushAccent}" FontWeight="SemiBold" Text="{Binding WordsToday, Mode=OneWay}"/>
</TextBlock>
</Border>
<Border Style="{StaticResource Chip}">
<TextBlock Style="{StaticResource ChipMutedText}" Text="{Binding NoiseSuppressionText}"/>
</Border>
</StackPanel>
</Grid>
<!-- Центр: страница История -->
<Grid Grid.Column="1" Visibility="{Binding ShowHistory, Converter={StaticResource BoolVis}}" Margin="20">
<Grid.RowDefinitions>
<RowDefinition Height="Auto"/>
<RowDefinition Height="*"/>
</Grid.RowDefinitions>
<TextBox Style="{StaticResource DarkBox}" Margin="0,0,0,12"
Text="{Binding HistorySearch, UpdateSourceTrigger=PropertyChanged}"
ToolTip="Поиск по истории диктовок"/>
<ListBox Grid.Row="1" ItemsSource="{Binding HistoryItems}"
SelectedItem="{Binding SelectedHistoryItem}"
Background="Transparent" BorderThickness="0"
ScrollViewer.VerticalScrollBarVisibility="Auto">
<ListBox.ItemContainerStyle>
<Style TargetType="ListBoxItem">
<Setter Property="Margin" Value="0,0,0,8"/>
<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
<Setter Property="Template">
<Setter.Value>
<ControlTemplate TargetType="ListBoxItem">
<Border x:Name="bd" Background="Transparent" CornerRadius="10" Padding="2">
<ContentPresenter/>
</Border>
<ControlTemplate.Triggers>
<Trigger Property="IsMouseOver" Value="True">
<Setter TargetName="bd" Property="Background" Value="{StaticResource BrushHover}"/>
</Trigger>
<Trigger Property="IsSelected" Value="True">
<Setter TargetName="bd" Property="Background" Value="{StaticResource BrushAccentDim}"/>
</Trigger>
</ControlTemplate.Triggers>
</ControlTemplate>
</Setter.Value>
</Setter>
</Style>
</ListBox.ItemContainerStyle>
<ListBox.ItemTemplate>
<DataTemplate>
<Border Style="{StaticResource CardBorder}" Padding="12,10">
<StackPanel>
<Grid>
<TextBlock Style="{StaticResource ChipText}" Text="{Binding WhenText}" HorizontalAlignment="Left"/>
<TextBlock Style="{StaticResource ChipMutedText}" HorizontalAlignment="Right">
<Run Text="{Binding Chars, Mode=OneWay}"/><Run Text=" символов"/>
</TextBlock>
</Grid>
<TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,6,0,0"
Foreground="{StaticResource BrushText}" MaxHeight="66" TextTrimming="CharacterEllipsis"/>
</StackPanel>
</Border>
</DataTemplate>
</ListBox.ItemTemplate>
</ListBox>
</Grid>
<!-- Транскрипт справа -->
<Border Grid.Column="2" Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1,0,0,0">
<Grid Margin="16">
<Grid.RowDefinitions>
<RowDefinition Height="Auto"/>
<RowDefinition Height="*"/>
<RowDefinition Height="Auto"/>
</Grid.RowDefinitions>
<StackPanel Orientation="Horizontal" Margin="0,0,0,12">
<TextBlock Text="Транскрипт" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
<Border Style="{StaticResource Chip}" Padding="10,4" Margin="12,0,0,0" VerticalAlignment="Center">
<TextBlock Style="{StaticResource ChipText}" Text="{Binding LanguageLabel}"/>
</Border>
</StackPanel>
<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
<ItemsControl ItemsSource="{Binding TranscriptSegments}">
<ItemsControl.ItemTemplate>
<DataTemplate>
<Border Style="{StaticResource Chip}" Padding="12,10" Margin="0,0,0,8" HorizontalAlignment="Stretch">
<Grid>
<Grid.ColumnDefinitions>
<ColumnDefinition Width="Auto"/>
<ColumnDefinition Width="*"/>
</Grid.ColumnDefinitions>
<TextBlock Style="{StaticResource ChipText}" Text="{Binding Timecode}" Margin="0,0,10,0"/>
<TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" Foreground="{StaticResource BrushText}"/>
</Grid>
</Border>
</DataTemplate>
</ItemsControl.ItemTemplate>
</ItemsControl>
</ScrollViewer>
<TextBlock Grid.Row="2" Style="{StaticResource ChipMutedText}" Text="{Binding LastSessionText}" Margin="0,10,0,0"/>
</Grid>
</Border>
<!-- Настройки: страница внутри главного окна (центр+право), без отдельного диалога -->
<Border Grid.Column="1" Grid.ColumnSpan="2"
Background="{StaticResource BrushBg}"
Visibility="{Binding ShowSettings, Converter={StaticResource BoolVis}}">
<controls:SettingsPane x:Name="SettingsHost"/>
</Border>
</Grid>
<!-- Нижний бар -->
<Border Grid.Row="2" Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0">
<Grid Height="64" Margin="16,0">
<Button Content="Настройки" Click="OnSettingsClick" Style="{StaticResource FlatButton}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
<Ellipse Width="8" Height="8" Fill="{StaticResource BrushOk}" VerticalAlignment="Center" Margin="0,0,8,0"/>
<TextBlock Text="{Binding StatusText}" Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center" MaxWidth="700" TextTrimming="CharacterEllipsis"/>
</StackPanel>
<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
<Button Content="Копировать" Command="{Binding CopyCommand}" Style="{StaticResource AccentButton}" Margin="0,0,8,0"/>
<Button Content="Очистить" Command="{Binding ClearCommand}" Style="{StaticResource DangerButton}"/>
</StackPanel>
</Grid>
</Border>
</Grid>
</Window>