<Window x:Class="Leron.Audio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Leron.Audio.Controls"
        Title="LERON-AUDIO"
        Width="520" Height="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBg}"
        Style="{StaticResource BaseWindow}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:LevelMeter x:Name="LevelMeter" Height="28" Margin="0,0,0,16"/>

        <Button x:Name="PttButton"
                Grid.Row="1"
                Height="120"
                Command="{Binding ToggleRecordingCommand}"
                RenderTransformOrigin="0.5,0.5"
                Margin="0,0,0,16">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource PttButton}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRecording}" Value="True">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="Foreground" Value="Black"/>
                            <Setter Property="BorderBrush" Value="White"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Viewbox Width="30" Height="30" Margin="0,0,14,0">
                    <!-- Монохромный микрофон: капсула + дуга + ножка -->
                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M12,14 C13.66,14 15,12.66 15,11 L15,5 C15,3.34 13.66,2 12,2 C10.34,2 9,3.34 9,5 L9,11 C9,12.66 10.34,14 12,14 Z M17,11 C17,13.76 14.76,16 12,16 C9.24,16 7,13.76 7,11 L5,11 C5,14.53 7.61,17.43 11,17.92 L11,21 L13,21 L13,17.92 C16.39,17.43 19,14.53 19,11 L17,11 Z"/>
                </Viewbox>
                <TextBlock Text="{Binding RecordButtonText}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

        <Border Grid.Row="2"
                Background="{StaticResource BrushPanel}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBox Text="{Binding Transcript, Mode=OneWay}"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         Background="Transparent"
                         Foreground="{StaticResource BrushText}"
                         BorderThickness="0"
                         FontSize="14"
                         AcceptsReturn="True"/>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="3"
                   Text="{Binding StatusText}"
                   Foreground="{StaticResource BrushMuted}"
                   TextWrapping="Wrap"
                   Margin="0,16,0,0"
                   FontSize="13"/>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Button Content="Настройки"
                    Click="OnSettingsClick"
                    Style="{StaticResource FlatButton}"
                    HorizontalAlignment="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Копировать"
                        Command="{Binding CopyCommand}"
                        Style="{StaticResource FlatButton}"
                        Margin="0,0,8,0"/>
                <Button Content="Очистить"
                        Command="{Binding ClearCommand}"
                        Style="{StaticResource FlatButton}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>