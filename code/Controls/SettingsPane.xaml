<UserControl x:Class="Leron.Audio.Controls.SettingsPane"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<UserControl.Resources>
<Style x:Key="FieldLabel" TargetType="TextBlock">
<Setter Property="Foreground" Value="{StaticResource BrushMuted}"/>
<Setter Property="Margin" Value="0,0,0,6"/>
<Setter Property="TextWrapping" Value="Wrap"/>
<Setter Property="FontSize" Value="13"/>
</Style>
<Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource FlatButton}"/>
<Style x:Key="PathBox" TargetType="TextBox" BasedOn="{StaticResource DarkBox}">
<Setter Property="IsReadOnly" Value="True"/>
<Setter Property="Foreground" Value="{StaticResource BrushMuted}"/>
</Style>
</UserControl.Resources>
<Grid Margin="20">
<Grid.RowDefinitions>
<RowDefinition Height="Auto"/>
<RowDefinition Height="*"/>
<RowDefinition Height="Auto"/>
<RowDefinition Height="Auto"/>
</Grid.RowDefinitions>
<StackPanel Orientation="Horizontal" Margin="0,0,0,12">
<TextBlock Text="Настройки"
FontSize="18"
FontWeight="SemiBold"
VerticalAlignment="Center"/>
</StackPanel>
<TabControl x:Name="Tabs" Grid.Row="1">
<TabItem Header="Общие">
<ScrollViewer VerticalScrollBarVisibility="Auto">
<StackPanel Margin="12">
<TextBlock Style="{StaticResource SectionHeader}" Text="ТРАНСКРИПЦИЯ"/>
<TextBlock Style="{StaticResource FieldLabel}" Margin="0,6,0,6" Text="Язык распознавания"/>
<ComboBox ItemsSource="{Binding LanguageNames}"
SelectedIndex="{Binding SelectedLanguageIndex}"/>
<TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,6"
Text="Модель Whisper (скачанные отмечены галкой)"/>
<ComboBox ItemsSource="{Binding ModelNames}"
SelectedIndex="{Binding SelectedModelIndex}"/>
<TextBlock Text="{Binding ModelStatusText}" TextWrapping="Wrap" Margin="0,6,0,0">
<TextBlock.Style>
<Style TargetType="TextBlock">
<Setter Property="Foreground" Value="{StaticResource BrushText}"/>
<Style.Triggers>
<DataTrigger Binding="{Binding ModelStatusIsError}" Value="True">
<Setter Property="Foreground" Value="{StaticResource BrushDanger}"/>
</DataTrigger>
</Style.Triggers>
</Style>
</TextBlock.Style>
</TextBlock>
<ProgressBar Value="{Binding DownloadProgress, Mode=OneWay}"
Minimum="0" Maximum="1" Height="8" Margin="0,8,0,8"
Background="{StaticResource BrushPanel}"
Foreground="{StaticResource BrushAccent}"
BorderBrush="{StaticResource BrushBorder}"/>
<StackPanel Orientation="Horizontal" Margin="0,0,0,12">
<Button Content="Скачать"
Command="{Binding DownloadSelectedModelCommand}"
Style="{StaticResource AccentButton}"
Margin="0,0,8,0"/>
<Button Content="Отмена"
Command="{Binding CancelDownloadCommand}"
Style="{StaticResource ActionButton}"
Margin="0,0,8,0"/>
<Button Content="Удалить"
Command="{Binding DeleteSelectedModelCommand}"
Style="{StaticResource DangerButton}"
Margin="0,0,8,0"/>
<Button Content="Диагностика"
Command="{Binding RunDiagnosticsCommand}"
Style="{StaticResource ActionButton}"/>
</StackPanel>
<TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,6"
Text="Устройство исполнения (на чём работает ИИ)"/>
<ComboBox ItemsSource="{Binding RuntimeNames}"
SelectedIndex="{Binding SelectedRuntimeIndex}"/>
<TextBlock Style="{StaticResource ChipMutedText}" Margin="0,6,0,12"
TextWrapping="Wrap"
Text="{Binding RuntimeDetectedText}"/>
<TextBlock Style="{StaticResource SectionHeader}" Text="ЗАПУСК"/>
<CheckBox Content="Запускать вместе с Windows"
IsChecked="{Binding AutoStartWithWindows}"
Margin="0,6,0,6"/>
<CheckBox Content="Запускать свёрнутым"
IsChecked="{Binding StartMinimized}"/>
</StackPanel>
</ScrollViewer>
</TabItem>
<TabItem Header="Аудио">
<ScrollViewer VerticalScrollBarVisibility="Auto">
<StackPanel Margin="12">
<TextBlock Style="{StaticResource SectionHeader}" Text="МИКРОФОН"/>
<TextBlock Style="{StaticResource FieldLabel}" Margin="0,6,0,6"
Text="Устройство записи: если волна не двигается при голосе — выбери другое"/>
<ComboBox ItemsSource="{Binding MicrophoneNames}"
SelectedIndex="{Binding SelectedMicrophoneIndex}"/>
<TextBlock Style="{StaticResource SectionHeader}" Margin="0,16,0,0" Text="ОБРАБОТКА ЗАПИСИ"/>
<CheckBox Content="Нормализовать громкость к -1 dBFS (тихие диктовки вытягивает, громкие прижимает)"
IsChecked="{Binding NormalizeAudio}"
Margin="0,8,0,6"/>
<CheckBox Content="Шумодав: гейт по шумовому полу + high-pass 80 Гц (срезует гул и дыхание)"
IsChecked="{Binding NoiseGate}"
Margin="0,0,0,8"/>
<TextBlock Style="{StaticResource FieldLabel}"
Text="Применяется к записи перед распознаванием сразу после «Сохранить», перезапуск не нужен."/>
</StackPanel>
</ScrollViewer>
</TabItem>
<TabItem Header="Клавиши">
<StackPanel Margin="12">
<TextBlock Style="{StaticResource FieldLabel}"
Text="Хоткей записи (PTT): кликни в поле и нажми сочетание клавиш"/>
<TextBox x:Name="HotkeyBox"
Style="{StaticResource DarkBox}"
Text="{Binding HotkeyText, Mode=OneWay}"
IsReadOnly="True"/>
<CheckBox Content="Автоматически вставлять текст в активное окно (Ctrl+V)"
IsChecked="{Binding AutoPaste}"
Margin="0,12,0,8"/>
<TextBlock Style="{StaticResource FieldLabel}"
Text="Если выключено — текст только копируется в буфер обмена. Ctrl+V никогда не отправляется в окно самого LERON-AUDIO."/>
</StackPanel>
</TabItem>
<TabItem Header="Хранилище">
<ScrollViewer VerticalScrollBarVisibility="Auto">
<StackPanel Margin="12">
<TextBlock Style="{StaticResource SectionHeader}" Text="ПУТИ"/>
<TextBlock Style="{StaticResource FieldLabel}" Margin="0,6,0,6" Text="Папка моделей"/>
<Grid Margin="0,0,0,10">
<Grid.ColumnDefinitions>
<ColumnDefinition Width="*"/>
<ColumnDefinition Width="Auto"/>
</Grid.ColumnDefinitions>
<TextBox Style="{StaticResource PathBox}" Text="{Binding ModelsDirText, Mode=OneWay}"/>
<Button Grid.Column="1" Content="Открыть"
Command="{Binding OpenModelsFolderCommand}"
Style="{StaticResource ActionButton}" Margin="8,0,0,0"/>
</Grid>
<TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,6" Text="Файл истории диктовок"/>
<Grid Margin="0,0,0,10">
<Grid.ColumnDefinitions>
<ColumnDefinition Width="*"/>
<ColumnDefinition Width="Auto"/>
</Grid.ColumnDefinitions>
<TextBox Style="{StaticResource PathBox}" Text="{Binding HistoryFileText, Mode=OneWay}"/>
<Button Grid.Column="1" Content="Открыть"
Command="{Binding OpenHistoryFolderCommand}"
Style="{StaticResource ActionButton}" Margin="8,0,0,0"/>
</Grid>
<TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,6" Text="Папка логов (для диагностики)"/>
<TextBox Style="{StaticResource PathBox}" Text="{Binding LogDirText, Mode=OneWay}"/>
<TextBlock Style="{StaticResource SectionHeader}" Margin="0,16,0,0" Text="ИСТОРИЯ ДИКТОВОК"/>
<Button Content="Очистить всю историю"
Command="{Binding ClearHistoryAllCommand}"
Style="{StaticResource DangerButton}"
HorizontalAlignment="Left"
Margin="0,8,0,12"/>
<TextBlock Style="{StaticResource FieldLabel}" Text="Удалить диапазон (дд.мм.гггг):"/>
<StackPanel Orientation="Horizontal">
<TextBox Style="{StaticResource DarkBox}" Width="110"
Text="{Binding HistoryFromText, UpdateSourceTrigger=PropertyChanged}"/>
<TextBlock Text=" — " VerticalAlignment="Center" Margin="6,0"/>
<TextBox Style="{StaticResource DarkBox}" Width="110"
Text="{Binding HistoryToText, UpdateSourceTrigger=PropertyChanged}"/>
<Button Content="Удалить диапазон"
Command="{Binding ClearHistoryRangeCommand}"
Style="{StaticResource ActionButton}" Margin="10,0,0,0"/>
</StackPanel>
</StackPanel>
</ScrollViewer>
</TabItem>
<TabItem Header="Словарь">
<StackPanel Margin="12">
<TextBlock Style="{StaticResource FieldLabel}"
Text="Словарь-подсказка (термины): учит Whisper писать EN-слова латиницей внутри русской речи. Применяется без перезапуска."/>
<TextBox Style="{StaticResource DarkBox}"
Height="260"
TextWrapping="Wrap"
AcceptsReturn="True"
VerticalScrollBarVisibility="Auto"
Text="{Binding InitialPrompt, UpdateSourceTrigger=PropertyChanged}"/>
</StackPanel>
</TabItem>
</TabControl>
<TextBlock Grid.Row="2"
Text="{Binding StatusMessage}"
Foreground="{StaticResource BrushMuted}"
TextWrapping="Wrap"
Margin="0,8,0,8"/>
<StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
<Button Content="Сохранить"
Command="{Binding SaveCommand}"
Style="{StaticResource AccentButton}"/>
</StackPanel>
</Grid>
</UserControl>