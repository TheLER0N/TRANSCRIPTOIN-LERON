<Window x:Class="Leron.Audio.Windows.RecordingOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Leron.Audio.Controls"
        Title="LERON-AUDIO · Запись"
        Width="440" Height="88"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        IsHitTestVisible="False">
    <Border x:Name="Root"
            Background="#E60B0F10"
            BorderBrush="{StaticResource BrushBorder}"
            BorderThickness="1"
            CornerRadius="22"
            Padding="18,12">
        <Border.RenderTransform>
            <TranslateTransform x:Name="Slide" Y="160"/>
        </Border.RenderTransform>
        <Grid>
            <!-- Состояние: запись -->
            <StackPanel x:Name="StateRecording" Orientation="Horizontal" VerticalAlignment="Center">
                <Viewbox Width="22" Height="22" Margin="0,0,12,0">
                    <Path Fill="{StaticResource BrushAccent}"
                          Data="M12,14 C13.66,14 15,12.66 15,11 L15,5 C15,3.34 13.66,2 12,2 C10.34,2 9,3.34 9,5 L9,11 C9,12.66 10.34,14 12,14 Z M17,11 C17,13.76 14.76,16 12,16 C9.24,16 7,13.76 7,11 L5,11 C5,14.53 7.61,17.43 11,17.92 L11,21 L13,21 L13,17.92 C16.39,17.43 19,14.53 19,11 L17,11 Z"/>
                </Viewbox>
                <controls:LevelMeter x:Name="OverlayBars" Width="250" Height="36" VerticalBars="True" Margin="0,0,14,0"/>
                <TextBlock x:Name="TimerText" Text="00:00" FontFamily="Consolas" FontSize="18"
                           Foreground="{StaticResource BrushText}" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Состояние: распознаю -->
            <StackPanel x:Name="StateRecognizing" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                <Ellipse Width="10" Height="10" Fill="{StaticResource BrushAccent}" Margin="0,0,12,0"/>
                <TextBlock Text="Распознаю…" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource BrushText}" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Состояние: микрофон выключен -->
            <StackPanel x:Name="StateMicOff" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                <Viewbox Width="22" Height="22" Margin="0,0,12,0">
                    <Grid>
                        <Path Fill="{StaticResource BrushDanger}"
                              Data="M12,14 C13.66,14 15,12.66 15,11 L15,5 C15,3.34 13.66,2 12,2 C10.34,2 9,3.34 9,5 L9,11 C9,12.66 10.34,14 12,14 Z M17,11 C17,13.76 14.76,16 12,16 C9.24,16 7,13.76 7,11 L5,11 C5,14.53 7.61,17.43 11,17.92 L11,21 L13,21 L13,17.92 C16.39,17.43 19,14.53 19,11 L17,11 Z"/>
                        <Path Stroke="{StaticResource BrushDanger}" StrokeThickness="2.4" Data="M4,4 L20,20"/>
                    </Grid>
                </Viewbox>
                <TextBlock Text="Микрофон выключен или недоступен" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource BrushDanger}" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>