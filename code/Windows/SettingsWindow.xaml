<Window x:Class="Leron.Audio.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки"
        Width="460" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBg}"
        Style="{StaticResource BaseWindow}">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushMuted}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource FlatButton}"/>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TabControl>
            <TabItem Header="Горячие клавиши">
                <StackPanel Margin="12">
                    <TextBlock Style="{StaticResource FieldLabel}"
                               Text="Хоткей записи (PTT): кликни в поле и нажми сочетание клавиш"/>
                    <TextBox x:Name="HotkeyBox"
                             Style="{StaticResource DarkBox}"
                             Text="{Binding HotkeyText, Mode=OneWay}"
                             IsReadOnly="True"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="Микрофон">
                <StackPanel Margin="12">
                    <TextBlock Style="{StaticResource FieldLabel}"
                               Text="Устройство записи: если VU-метр не двигается при голосе — выбери другой микрофон"/>
                    <ComboBox ItemsSource="{Binding MicrophoneNames}"
                              SelectedIndex="{Binding SelectedMicrophoneIndex}"/>
                    <TextBlock Style="{StaticResource FieldLabel}"
                               Margin="0,10,0,0"
                               Text="Применяется сразу после «Сохранить», перезапуск не нужен."/>
                </StackPanel>
            </TabItem>
            <TabItem Header="Вставка">
                <StackPanel Margin="12">
                    <CheckBox Content="Автоматически вставлять текст в активное окно (Ctrl+V)"
                              IsChecked="{Binding AutoPaste}"
                              Margin="0,4,0,8"/>
                    <TextBlock Style="{StaticResource FieldLabel}"
                               Text="Если выключено — текст только копируется в буфер обмена."/>
                </StackPanel>
            </TabItem>
            <TabItem Header="Модель">
                <StackPanel Margin="12">
                    <TextBlock Style="{StaticResource FieldLabel}"
                               Text="Путь к ggml-*.bin (пусто = автопоиск в корне проекта)"/>
                    <TextBox Style="{StaticResource DarkBox}"
                             Text="{Binding ModelPath, UpdateSourceTrigger=PropertyChanged}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,8">
                        <Button Content="Проверить"
                                Command="{Binding CheckModelCommand}"
                                Style="{StaticResource ActionButton}"
                                Margin="0,0,8,0"/>
                        <Button Content="Диагностика"
                                Command="{Binding RunDiagnosticsCommand}"
                                Style="{StaticResource ActionButton}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding ModelStatusText}" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ModelStatusIsError}" Value="True">
                                        <Setter Property="Foreground" Value="#FF5555"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Style="{StaticResource FieldLabel}"
                               Margin="0,12,0,6"
                               Text="Словарь-подсказка (термины): учит Whisper писать EN-слова латиницей внутри русской речи"/>
                    <TextBox Style="{StaticResource DarkBox}"
                             Height="90"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Text="{Binding InitialPrompt, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="Запуск">
                <StackPanel Margin="12">
                    <CheckBox Content="Запускать свёрнутым"
                              IsChecked="{Binding StartMinimized}"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="1"
                   Text="{Binding StatusMessage}"
                   Foreground="{StaticResource BrushMuted}"
                   TextWrapping="Wrap"
                   Margin="0,8,0,8"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource ActionButton}"/>
        </StackPanel>
    </Grid>
</Window>